# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# When using ngrok, set this to the current HTTPS tunnel origin and keep the
# local Next.js server and tunnel running. Cookies remain host-only.

# Database
DATABASE_URL=""

# Simulated mobile-money checkout only. Never set this to a real provider.
SIMULATED_PAYMENTS_ENABLED=true
SIMULATED_PAYMENT_ADAPTER=mock

# Authentication
AUTH_SECRET=""
AUTH_ISSUER=""
AUTH_AUDIENCE="somali-marketplace-api"
# Exactly 32 bytes: either 64 hexadecimal characters or 44 canonical Base64 characters.
ADMIN_MFA_ENCRYPTION_KEY=""

# Google reCAPTCHA v3 (required for protected authentication and vendor submission flows)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_MIN_SCORE=0.5

# Email delivery (SMTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Amazon Login with Amazon OAuth
AMAZON_CLIENT_ID=""
AMAZON_CLIENT_SECRET=""
AMAZON_REDIRECT_URI=""
# Must be the exact HTTPS callback registered in Amazon Login with Amazon.
# For local OAuth testing, use the same current HTTPS tunnel origin in
# NEXT_PUBLIC_APP_URL and AMAZON_REDIRECT_URI.

# Private administrator provisioning (only for `npm run admin:provision`)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""