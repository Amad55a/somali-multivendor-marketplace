
// Somali Multi-Vendor Marketplace
// Phase 1 + Phase 2: Foundation and Authentication Security
// PostgreSQL + Prisma 7

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum AccountType {
  CUSTOMER
  VENDOR
  ADMIN
}

enum AuthProvider {
  LOCAL
  AMAZON
}

enum VerificationPurpose {
  EMAIL_VERIFY
  ADMIN_LOGIN
  PASSWORD_RESET
}

enum VendorApplicationStatus {
  DRAFT
  PENDING
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum VendorVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum VendorFileType {
  STORE_LOGO
  BUSINESS_LICENSE
}

enum VendorApplicationEmailEvent {
  SUBMITTED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  PROFILE_CHANGE_SUBMITTED
  PROFILE_CHANGE_APPROVED
  PROFILE_CHANGE_REJECTED
}

enum VendorProfileChangeStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum MarketplaceOrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  FULFILLING
  COMPLETED
}

enum VendorOrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  PACKED
  READY
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum SimulatedPaymentMethod {
  EVC_PLUS
  ZAAD
  EDAHAB
}

enum StockReservationStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  RELEASED
}

enum CouponScope {
  VENDOR
  PLATFORM
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ReturnRequestStatus {
  REQUESTED
  VENDOR_APPROVED
  VENDOR_REJECTED
  RETURN_SHIPPED
  ESCALATED
  IN_REVIEW
  ADMIN_APPROVED
  ADMIN_REJECTED
  RETURNED
  RECEIVED
  REFUND_PROCESSING
  REFUNDED
}

enum LedgerEntryType {
  SALE
  COMMISSION
  VENDOR_DISCOUNT
  PLATFORM_DISCOUNT
  DELIVERY_FEE
  REFUND
  REFUND_ADJUSTMENT
  PAYOUT
  ADJUSTMENT
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  SIMULATED_PAID
  FAILED
  CANCELLED
}

enum PaymentMode {
  SIMULATED
}

enum PaymentRecordStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REVERSED
}

enum SimulatedPaymentAttemptStatus {
  PENDING
  SIMULATED_SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

enum SmsOutboxStatus {
  QUEUED
  SAVED_TO_OUTBOX
  FAILED_TO_SAVE
}

enum SupportTicketCategory {
  ORDERS
  PAYMENTS
  DELIVERY
  RETURNS
  REFUNDS
  ACCOUNT
  PRODUCT_ISSUES
  SAFETY
  VENDOR_APPLICATION
  STORE_PROFILE
  PRODUCT_LISTING
  INVENTORY
  COUPONS
  COMMISSION_PAYOUTS
  ACCOUNT_SECURITY
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  WAITING_FOR_VENDOR
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketActivityType {
  CREATED
  MESSAGE_ADDED
  ASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  INTERNAL_NOTE_ADDED
}

enum SupportEmailEvent {
  TICKET_CREATED
  TICKET_RESOLVED
}

enum SupportEmailDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum ConversationMessageType {
  TEXT
  PRODUCT
  ORDER
  IMAGE
  SYSTEM
}

enum CommunicationReportReason {
  SPAM
  HARASSMENT
  FRAUD
  IMPERSONATION
  INAPPROPRIATE_CONTENT
  OTHER
}

enum CommunicationReportStatus {
  OPEN
  INVESTIGATING
  DISMISSED
  ACTIONED
}

// ==========================================
// 1. USERS
// ==========================================

model User {
  id              String      @id @default(uuid()) @db.Uuid
  email           String      @db.VarChar(254)
  normalizedEmail String      @db.VarChar(254)
  accountType     AccountType
  emailVerifiedAt DateTime?   @db.Timestamptz(6)
  displayName     String?     @db.VarChar(160)
  profileImageKey String?     @db.VarChar(500)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(6)

  authAccounts           UserAuthAccount[]
  sessions               UserSession[]
  auditLogs              AuditLog[] @relation("AuditActor")
  emailVerificationCodes EmailVerificationCode[]
  adminMfaMethod         AdminMfaMethod?
  adminRecoveryCodes     AdminRecoveryCode[]
  adminLoginChallenges   AdminLoginChallenge[]
  loginAttempts          LoginAttempt[]
  vendorProfile            VendorProfile?
  reviewedVendorProfiles   VendorProfile[] @relation("VendorProfileReviewer")
  reviewedProfileChanges   VendorProfileChangeRequest[] @relation("ProfileChangeReviewer")
  products                 Product[]
  productImages            ProductImage[]
  cart                     ShoppingCart?
  customerOrders           MarketplaceOrder[]
  vendorOrders             VendorOrder[]
  vendorNotifications      VendorNotification[]
  customerNotifications    CustomerNotification[]
  stockReservations        StockReservation[]
  productReviews           ProductReview[]
  couponRedemptions        CouponRedemption[]
  returnRequests           ReturnRequest[] @relation("ReturnCustomer")
  vendorReturnReviews      ReturnRequest[] @relation("ReturnVendor")
  adminReturnReviews       ReturnRequest[] @relation("ReturnAdmin")
  updatedCommissionSettings CommissionSettings[] @relation("CommissionSettingsUpdater")
  updatedCategoryCommissions CategoryCommission[] @relation("CategoryCommissionUpdater")
  categoryCommissionChanges CategoryCommissionHistory[] @relation("CategoryCommissionChangedBy")
  coupons                  Coupon[]
  ledgerEntries            LedgerEntry[]
  payouts                  VendorPayout[]
  createdPayoutBatches     PayoutBatch[] @relation("PayoutBatchCreator")
  approvedPayoutBatches    PayoutBatch[] @relation("PayoutBatchApprover")
  approvedVendorPayouts    VendorPayout[] @relation("VendorPayoutApprover")
  deliveryRule             VendorDeliveryRule?
  paymentAttempts          SimulatedPaymentAttempt[]
  paymentReceipts          PaymentReceipt[]
  smsOutboxMessages        SmsOutboxMessage[]
  requestedSupportTickets SupportTicket[]         @relation("SupportRequester")
  assignedSupportTickets  SupportTicket[]         @relation("SupportAssignee")
  supportMessages         SupportMessage[]        @relation("SupportMessageSender")
  uploadedSupportFiles    SupportAttachment[]     @relation("SupportAttachmentUploader")
  supportTicketActivities SupportTicketActivity[] @relation("SupportActivityActor")
  customerConversations   Conversation[]          @relation("ConversationCustomer")
  vendorConversations     Conversation[]          @relation("ConversationVendor")
  conversationMessages    ConversationMessage[]  @relation("ConversationMessageSender")
  conversationAttachments ConversationAttachment[] @relation("ConversationAttachmentUploader")
  communicationBlocksGiven CommunicationBlock[]  @relation("CommunicationBlocker")
  communicationBlocksReceived CommunicationBlock[] @relation("CommunicationBlocked")
  communicationReportsMade CommunicationReport[] @relation("CommunicationReporter")
  communicationReportsAgainst CommunicationReport[] @relation("CommunicationReported")
  communicationReportsReviewed CommunicationReport[] @relation("CommunicationReportReviewer")
  conversationPresence  ConversationPresence[]

  @@unique([id, accountType])
  @@unique([accountType, normalizedEmail])
  @@index([email])
  @@index([accountType, isActive])
  @@map("users")
}

// ==========================================
// 2. USER AUTHENTICATION ACCOUNTS
// ==========================================

model UserAuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  accountType       AccountType
  provider          AuthProvider
  providerAccountId String?      @db.VarChar(255)
  passwordHash      String?      @db.VarChar(255)
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId, accountType], references: [id, accountType], onDelete: Cascade)

  @@unique([provider, providerAccountId, accountType])
  @@index([userId])
  @@map("user_auth_accounts")
}

// ==========================================
// 3. USER SESSIONS
// ==========================================

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  sessionTokenHash String    @unique @db.VarChar(255)
  refreshTokenHash String?   @unique @db.VarChar(255)
  lastActivityAt   DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt        DateTime  @db.Timestamptz(6)
  refreshExpiresAt DateTime? @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ==========================================
// 4. AUDIT LOGS
// ==========================================

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String?  @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// 5. EMAIL VERIFICATION CODES
// ==========================================

model EmailVerificationCode {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  codeHash  String             @db.VarChar(255)
  purpose   VerificationPurpose
  expiresAt DateTime           @db.Timestamptz(6)
  usedAt    DateTime?          @db.Timestamptz(6)
  createdAt DateTime           @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([expiresAt])
  @@map("email_verification_codes")
}

// ==========================================
// 6. ADMIN MFA METHODS
// ==========================================

model AdminMfaMethod {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  encryptedSecret String    @db.VarChar(1024)
  enabled         Boolean   @default(false)
  verifiedAt      DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_mfa_methods")
}

// ==========================================
// 7. ADMIN RECOVERY CODES
// ==========================================

model AdminRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @db.VarChar(255)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("admin_recovery_codes")
}

// Short-lived, one-use challenges issued only after admin password and email OTP checks.
model AdminLoginChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("admin_login_challenges")
}

// ==========================================
// 8. LOGIN ATTEMPTS
// ==========================================

model LoginAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  identifier  String   @db.VarChar(254)
  ipAddress   String?  @db.VarChar(45)
  successful  Boolean  @default(false)
  attemptedAt DateTime @default(now()) @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifier, attemptedAt])
  @@index([userId, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@map("login_attempts")
}

// A vendor profile is also the vendor's onboarding application.
model VendorProfile {
  id                     String                    @id @default(uuid()) @db.Uuid
  userId                 String                    @unique @db.Uuid
  accountType            AccountType                @default(VENDOR)
  applicationStatus      VendorApplicationStatus    @default(DRAFT)
  verificationStatus     VendorVerificationStatus  @default(UNVERIFIED)
  businessName           String?                   @db.VarChar(200)
  storeName              String?                   @db.VarChar(120)
  businessType           String?                   @db.VarChar(100)
  description            String?                   @db.VarChar(2000)
  contactName            String?                   @db.VarChar(160)
  phone                  String?                   @db.VarChar(32)
  country                String?                   @db.VarChar(100)
  region                 String?                   @db.VarChar(100)
  city                   String?                   @db.VarChar(100)
  district               String?                   @db.VarChar(100)
  address                String?                   @db.VarChar(300)
  marketAssociation      String?                   @db.VarChar(200)
  mobileMoneyNumber      String?                   @db.VarChar(32)
  files                  VendorApplicationFile[]
  emailDeliveries        VendorApplicationEmail[]
  changeRequests         VendorProfileChangeRequest[]
  supportTickets         SupportTicket[]
  submittedAt            DateTime?                 @db.Timestamptz(6)
  reviewedAt             DateTime?                 @db.Timestamptz(6)
  reviewedById           String?                   @db.Uuid
  rejectionReason        String?                   @db.VarChar(1000)
  informationRequest     String?                   @db.VarChar(1000)
  deliveryFee            Decimal                   @default(0) @db.Decimal(12, 2)
  createdAt              DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                  @updatedAt @db.Timestamptz(6)

  user       User  @relation(fields: [userId, accountType], references: [id, accountType], onDelete: Cascade)
  reviewedBy User? @relation("VendorProfileReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([userId, accountType])
  @@index([applicationStatus, submittedAt])
  @@index([reviewedById, reviewedAt])
  @@map("vendor_profiles")
}

model VendorApplicationFile {
  id              String        @id @default(uuid()) @db.Uuid
  vendorProfileId String        @db.Uuid
  fileType        VendorFileType
  storageKey      String        @unique @db.VarChar(500)
  originalName    String        @db.VarChar(255)
  mimeType        String        @db.VarChar(100)
  sizeBytes       Int
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  @@index([fileType, createdAt])
  @@unique([vendorProfileId, fileType])
  @@map("vendor_application_files")
}

model VendorApplicationEmail {
  id              String                       @id @default(uuid()) @db.Uuid
  vendorProfileId String                       @db.Uuid
  event           VendorApplicationEmailEvent
  recipientEmail  String                       @db.VarChar(254)
  attemptCount    Int                          @default(0)
  sentAt          DateTime?                    @db.Timestamptz(6)
  lastAttemptAt   DateTime?                    @db.Timestamptz(6)
  lastError       String?                      @db.VarChar(500)
  createdAt       DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                     @updatedAt @db.Timestamptz(6)

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  @@unique([vendorProfileId, event])
  @@index([sentAt, lastAttemptAt])
  @@map("vendor_application_emails")
}

model VendorProfileChangeRequest {
  id              String                     @id @default(uuid()) @db.Uuid
  vendorProfileId String                     @db.Uuid
  status          VendorProfileChangeStatus  @default(DRAFT)
  proposed        Json
  currentSnapshot Json
  vendorNote      String?                    @db.VarChar(1000)
  adminNote       String?                    @db.VarChar(1000)
  submittedAt     DateTime?                  @db.Timestamptz(6)
  reviewedAt      DateTime?                  @db.Timestamptz(6)
  reviewedById    String?                    @db.Uuid
  createdAt       DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                   @updatedAt @db.Timestamptz(6)

  vendorProfile VendorProfile              @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  reviewedBy    User?                      @relation("ProfileChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  files         VendorProfileChangeFile[]

  @@index([vendorProfileId, status, submittedAt])
  @@index([status, submittedAt])
  @@map("vendor_profile_change_requests")
}

model VendorProfileChangeFile {
  id              String        @id @default(uuid()) @db.Uuid
  changeRequestId String        @db.Uuid
  fileType        VendorFileType
  storageKey      String        @unique @db.VarChar(500)
  originalName    String        @db.VarChar(255)
  mimeType        String        @db.VarChar(100)
  sizeBytes       Int
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  changeRequest VendorProfileChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  @@unique([changeRequestId, fileType])
  @@map("vendor_profile_change_files")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(120)
  nameSo      String?   @db.VarChar(120)
  slug        String    @unique @db.VarChar(140)
  description String?   @db.VarChar(500)
  descriptionSo String? @db.VarChar(500)
  imageKey    String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  parentId    String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  products   Product[]
  parent     Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[] @relation("CategoryHierarchy")
  commission CategoryCommission?
  commissionHistory CategoryCommissionHistory[]

  @@index([isActive, name])
  @@index([parentId, isActive])
  @@map("categories")
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  vendorId        String        @db.Uuid
  categoryId      String        @db.Uuid
  name            String        @db.VarChar(200)
  nameSo          String?       @db.VarChar(200)
  slug            String        @db.VarChar(240)
  description     String?       @db.VarChar(4000)
  descriptionSo   String?       @db.VarChar(4000)
  brand           String?       @db.VarChar(120)
  condition       ProductCondition?
  status          ProductStatus  @default(DRAFT)
  marketAssociation String?     @db.VarChar(200)
  country         String?       @db.VarChar(100)
  region          String?       @db.VarChar(100)
  city            String?       @db.VarChar(100)
  marketName      String?       @db.VarChar(160)
  publishedAt     DateTime?     @db.Timestamptz(6)
  archivedAt      DateTime?     @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  vendor   User             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  images   ProductImage[]
  reviews  ProductReview[]
  supportTickets SupportTicket[]
  conversationMessages ConversationMessage[]

  @@unique([vendorId, slug])
  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([country, region, city, status])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String   @db.Uuid
  sku            String   @unique @db.VarChar(80)
  variantName    String   @db.VarChar(160)
  attributes     Json?
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  stockQuantity  Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  product            Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems          CartItem[]
  orderLines         OrderLine[]
  reservationItems   StockReservationItem[]

  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  vendorId    String   @db.Uuid
  storageKey  String   @unique @db.VarChar(500)
  originalName String  @db.VarChar(255)
  mimeType    String   @db.VarChar(100)
  sizeBytes   Int
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor  User    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([vendorId, productId])
  @@map("product_images")
}

model ShoppingCart {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @unique @db.Uuid
  guestKey  String?   @unique @db.VarChar(80)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("shopping_carts")
}

model CartItem {
  id            String   @id @default(uuid()) @db.Uuid
  cartId        String   @db.Uuid
  variantId     String   @db.Uuid
  quantity      Int
  capturedPrice Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  cart    ShoppingCart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model MarketplaceOrder {
  id             String                  @id @default(uuid()) @db.Uuid
  orderNumber    String                  @unique @db.VarChar(24)
  customerId     String                  @db.Uuid
  status         MarketplaceOrderStatus  @default(PENDING_PAYMENT)
  currency       String                  @default("USD") @db.VarChar(3)
  subtotalAmount Decimal                 @db.Decimal(12, 2)
  totalAmount    Decimal                 @db.Decimal(12, 2)
  contactName    String                  @db.VarChar(160)
  email          String                  @db.VarChar(254)
  phone          String                  @db.VarChar(32)
  country        String                  @db.VarChar(100)
  region         String                  @db.VarChar(100)
  city           String                  @db.VarChar(100)
  district       String?                 @db.VarChar(100)
  address        String                  @db.VarChar(300)
  instructions   String?                 @db.VarChar(1000)
  paymentMode    PaymentMode             @default(SIMULATED)
  paymentStatus  PaymentRecordStatus     @default(PENDING)
  simulated          Boolean                 @default(true)
  platformDiscount   Decimal                 @default(0) @db.Decimal(12, 2)
  deliveryTotal      Decimal                 @default(0) @db.Decimal(12, 2)
  createdAt          DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(6)

  customer      User               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vendorOrders  VendorOrder[]
  payment       PaymentRecord?
  reservation   StockReservation?
  redemptions   CouponRedemption[]
  ledgerEntries LedgerEntry[]
  returnRequests ReturnRequest[]
  refunds       SimulatedRefund[]
  paymentAttempts SimulatedPaymentAttempt[]
  receipt       PaymentReceipt?
  smsOutboxMessages SmsOutboxMessage[]
  supportTickets    SupportTicket[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
