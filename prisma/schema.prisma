  vendor      User?        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  order       MarketplaceOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendorOrder VendorOrder? @relation(fields: [vendorOrderId], references: [id], onDelete: SetNull)
  orderLine   OrderLine?   @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  payout      VendorPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  coupon      Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  relatedEntry LedgerEntry? @relation("LedgerEntryRelated", fields: [relatedEntryId], references: [id], onDelete: SetNull)
  reversals   LedgerEntry[] @relation("LedgerEntryRelated")
  payoutAllocations PayoutAllocation[]

  @@index([vendorId, createdAt])
  @@index([orderId, type])
  @@index([vendorOrderId, type])
  @@index([payoutId])
  @@map("ledger_entries")
}

model PayoutBatch {
  id          String       @id @default(uuid()) @db.Uuid
  weekKey     String       @unique @db.VarChar(20)
  periodStart DateTime     @db.Timestamptz(6)
  periodEnd   DateTime     @db.Timestamptz(6)
  status      PayoutStatus @default(PENDING)
  createdById String?      @db.Uuid
  approvedById String?     @db.Uuid
  approvedAt  DateTime?    @db.Timestamptz(6)
  processedAt DateTime?    @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)

  createdBy User? @relation("PayoutBatchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User? @relation("PayoutBatchApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  payouts VendorPayout[]

  @@index([status, createdAt])
  @@map("payout_batches")
}

model VendorPayout {
  id          String       @id @default(uuid()) @db.Uuid
  vendorId    String       @db.Uuid
  batchId     String?      @db.Uuid
  reference   String?      @unique @db.VarChar(40)
  periodStart DateTime     @db.Timestamptz(6)
  periodEnd   DateTime     @db.Timestamptz(6)
  amount      Decimal      @db.Decimal(12, 2)
  currency    String       @default("USD") @db.VarChar(3)
  status      PayoutStatus @default(PENDING)
  idempotencyKey String?   @unique @db.VarChar(120)
  simulated   Boolean      @default(true)
  approvedById String?     @db.Uuid
  approvedAt  DateTime?    @db.Timestamptz(6)
  processedAt DateTime?    @db.Timestamptz(6)
  failureReason String?    @db.VarChar(500)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)

  vendor  User          @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  batch   PayoutBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  approvedBy User?      @relation("VendorPayoutApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  entries LedgerEntry[]
  allocations PayoutAllocation[]

  @@unique([batchId, vendorId, currency])
  @@index([vendorId, createdAt])
  @@map("vendor_payouts")
}

model PayoutAllocation {
  id            String    @id @default(uuid()) @db.Uuid
  payoutId      String    @db.Uuid
  ledgerEntryId String    @db.Uuid
  releasedAt    DateTime? @db.Timestamptz(6)
  releaseReason String?   @db.VarChar(500)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  payout      VendorPayout @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  ledgerEntry LedgerEntry  @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)

  @@unique([payoutId, ledgerEntryId])
  @@index([ledgerEntryId, releasedAt])
  @@index([payoutId, releasedAt])
  @@map("payout_allocations")
}

model Conversation {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  vendorId   String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  customer User                    @relation("ConversationCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  vendor   User                    @relation("ConversationVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]
  blocks   CommunicationBlock[]
  reports  CommunicationReport[]
  presence ConversationPresence[]

  @@unique([customerId, vendorId])
  @@index([customerId, updatedAt])
  @@index([vendorId, updatedAt])
  @@map("conversations")
}

model ConversationMessage {
  id              String                  @id @default(uuid()) @db.Uuid
  conversationId  String                  @db.Uuid
  senderId        String                  @db.Uuid
  type            ConversationMessageType @default(TEXT)
  content         String?                 @db.VarChar(4000)
  productId       String?                 @db.Uuid
  attachmentData  Json?
  clientMessageId String                  @db.VarChar(80)
  deliveredAt     DateTime?               @db.Timestamptz(6)
  readAt          DateTime?               @db.Timestamptz(6)
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)

  conversation Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                    @relation("ConversationMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  product      Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  attachments  ConversationAttachment[]

  @@unique([conversationId, senderId, clientMessageId])
  @@unique([conversationId, productId])
  @@index([conversationId, createdAt])
  @@index([conversationId, senderId, readAt, createdAt])
  @@map("conversation_messages")
}

model ConversationAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  messageId    String   @db.Uuid
  uploadedById String   @db.Uuid
  storageKey   String   @unique @db.VarChar(500)
  originalName String   @db.VarChar(255)
  mimeType     String   @db.VarChar(100)
  sizeBytes    Int
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  message    ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy User                @relation("ConversationAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@map("conversation_attachments")
}

model CommunicationBlock {
  id          String   @id @default(uuid()) @db.Uuid
  blockerId   String   @db.Uuid
  blockedId   String   @db.Uuid
  conversationId String? @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  blocker      User          @relation("CommunicationBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked      User          @relation("CommunicationBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([blockerId, blockedId])
  @@index([blockedId, createdAt])
  @@index([conversationId])
  @@map("communication_blocks")
}

model CommunicationReport {
  id              String                     @id @default(uuid()) @db.Uuid
  conversationId  String                     @db.Uuid
  reporterId      String                     @db.Uuid
  reportedUserId  String                     @db.Uuid
  reason          CommunicationReportReason
  explanation     String?                    @db.VarChar(2000)
  status          CommunicationReportStatus  @default(OPEN)
  decisionReason  String?                    @db.VarChar(1000)
  reviewedById    String?                    @db.Uuid
  reviewedAt      DateTime?                  @db.Timestamptz(6)
  createdAt       DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                   @updatedAt @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reporter     User         @relation("CommunicationReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User         @relation("CommunicationReported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("CommunicationReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([conversationId, reporterId, reportedUserId])
  @@index([status, createdAt])
  @@index([reportedUserId, status, createdAt])
  @@map("communication_reports")
}

model ConversationPresence {
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  lastSeenAt     DateTime @default(now()) @db.Timestamptz(6)
  heartbeatAt    DateTime @default(now()) @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, heartbeatAt])
  @@map("conversation_presence")
}
